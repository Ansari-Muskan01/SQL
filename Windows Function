Window Function : 

A Window Function in SQL is a function that performs a calculation across a set of related rows without grouping those rows into a single row.

In simple words:
A Window Function calculates values for each row while keeping all the original rows in the result.

-- Syntax:
-- FUNCTION() OVER (
--     PARTITION BY column_name
--     ORDER BY column_name
-- );

| Function     | Purpose                   |
| -------------| ------------------------- |
| ROW_NUMBER() | Gives a unique row number |
| RANK()       | Gives rank with gaps      |
| DENSE_RANK() | Gives rank without gaps   |
| LAG()        | Gets previous row's value |
| LEAD()       | Gets next row's value     |


-- Create a new Orders table for Window Functions practice

CREATE TABLE Window_Orders (
    Order_ID INT PRIMARY KEY,
    Customer_Name VARCHAR(50),
    Food_Category VARCHAR(30),
    Order_Amount DECIMAL(10,2)
);

-- Insert 6 records

INSERT INTO Window_Orders (Order_ID, Customer_Name, Food_Category, Order_Amount)
VALUES (201, 'Aarav Sharma', 'Biryani', 900.00),
(202, 'Priya Mehta', 'Pizza', 750.00),
(203, 'Rahul Verma', 'Burger', 750.00),
(204, 'Sneha Patil', 'Chinese', 600.00),
(205, 'Aisha Khan', 'Biryani', 600.00),
(206, 'Rohan Joshi', 'Pizza', 400.00);

-- Check the table
SELECT * FROM Window_Orders;

-- Over Clause: The OVER clause is used with a Window Function to define the set of rows (window) on which the calculation will be performed.

-- Q: Display each Order_ID, Order_Amount, and the total Order_Amount of all orders.
SELECT Order_ID, Order_Amount, SUM(Order_Amount) OVER () AS Total_Order_Amount FROM Window_Orders;
    
    
-- Q: Display all columns from the Window_Orders table along with the total, average, minimum, and maximum Order_Amount for all orders using Window Functions.
    
SELECT
    *,
    SUM(Order_Amount) OVER () AS Total_Order_Amount,
    AVG(Order_Amount) OVER () AS Average_Order_Amount,
    MIN(Order_Amount) OVER () AS Minimum_Order_Amount,
    MAX(Order_Amount) OVER () AS Maximum_Order_Amount
FROM Window_Orders;


-- PARTITION BY : PARTITION BY is used with the OVER() clause to divide the rows into separate groups based on one or more columns.

-- Q: Display all columns from the Window_Orders table along with the total, average, minimum, and maximum Order_Amount for each Food_Category using Window Functions and PARTITION BY.

SELECT
    *,
    SUM(Order_Amount) OVER (PARTITION BY Food_Category) AS Category_Total,
    AVG(Order_Amount) OVER (PARTITION BY Food_Category) AS Category_Average,
    MIN(Order_Amount) OVER (PARTITION BY Food_Category) AS Category_Minimum,
    MAX(Order_Amount) OVER (PARTITION BY Food_Category) AS Category_Maximum FROM Window_Orders;



-- ROW_NUMBER() assigns a unique sequential number to each row.
-- Q: Assign a unique row number to each order based on Order_Amount from highest to lowest
SELECT Order_ID, Order_Amount, ROW_NUMBER() OVER (ORDER BY Order_Amount DESC) AS Row_Num FROM Window_Orders;

-- RANK() assigns the same rank to rows with the same value.The next rank is skipped.    
-- Q: Rank orders based on Order_Amount from highest to lowest.
SELECT Order_ID, Order_Amount, RANK() OVER (ORDER BY Order_Amount DESC) AS Order_Rank FROM Window_Orders;
    
-- DENSE_RANK() assigns the same rank to rows with the same value. The next rank is NOT skipped.
-- Q: Rank orders using DENSE_RANK() based on Order_Amount.
SELECT Order_ID, Order_Amount, DENSE_RANK() OVER (ORDER BY Order_Amount DESC) AS Dense_Order_Rank FROM Window_Orders;


-- LAG() returns the value from a previous row within the specified window.
-- Q: Display the Order_ID, Order_Amount, and the Order_Amount of the previous order based on Order_ID.
SELECT Order_ID,Order_Amount, LAG(Order_Amount) OVER (ORDER BY Order_ID) AS Previous_Order_Amount FROM Window_Orders;

-- LEAD() returns the value from a next row within the specified window.
SELECT Order_ID, Order_Amount, LEAD(Order_Amount) OVER (ORDER BY Order_ID) AS Next_Order_Amount FROM Window_Orders;
