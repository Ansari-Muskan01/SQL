-- SET OPERATORS IN SQL
-- Set Operators are used to combine the results of two or more SELECT queries.
-- The main set operators are:
-- UNION
-- UNION ALL
-- INTERSECT

CREATE TABLE Mumbai_Customers (
    Customer_ID INT,
    Customer_Name VARCHAR(50),
    City VARCHAR(30)
);

