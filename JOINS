-- EMPLOYEES TABLE

CREATE TABLE Employees (
    Employee_ID INT PRIMARY KEY,
    Employee_Name VARCHAR(50),
    Department VARCHAR(30),
    Manager_ID INT
);

INSERT INTO Employees (Employee_ID, Employee_Name, Department, Manager_ID)
VALUES
(1, 'Amit', 'IT', NULL),
(2, 'Priya', 'IT', 1),
(3, 'Rahul', 'HR', 1),
(4, 'Sneha', 'Finance', 1),
(5, 'Karan', 'IT', 2),
(6, 'Neha', 'HR', 3);

-- SELF JOIN
-- A table is joined with itself.
-- E1 = Employee table
-- E2 = Employee table
-- E1.Manager_ID is compared with E2.Employee_ID.

SELECT
    E1.Employee_Name AS Employee,
    E2.Employee_Name AS Manager
FROM Employees E1
JOIN Employees E2
ON E1.Manager_ID = E2.Employee_ID;

-- Display employee and manager department

SELECT
    E1.Employee_Name AS Employee,
    E1.Department AS Employee_Department,
    E2.Employee_Name AS Manager,
    E2.Department AS Manager_Department
FROM Employees E1
JOIN Employees E2
ON E1.Manager_ID = E2.Employee_ID;


-- CROSS JOIN
-- For CROSS JOIN, let's create a small Branches table.

-- BRANCHES TABLE

CREATE TABLE Branches (
    Branch_ID INT PRIMARY KEY,
    Branch_Name VARCHAR(50)
);

INSERT INTO Branches (Branch_ID, Branch_Name)
VALUES
(101, 'Mumbai Branch'),
(102, 'Pune Branch'),
(103, 'Nashik Branch');

-- CROSS JOIN
-- Every employee is combined with every branch.
-- E = Employees table
-- B = Branches table
-- No ON condition is required.

SELECT
    E.Employee_Name,
    B.Branch_Name
FROM Employees E
CROSS JOIN Branches B;

