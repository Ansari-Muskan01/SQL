# 3. Create Customers Table

-- Customer_ID: Unique ID for each customer.
-- Customer_Name: Stores the name of the customer.
-- Email: Stores the email address of the customer.
-- Phone: Stores the phone number of the customer.
-- City: Stores the city where the customer lives.
-- Age: Stores the age of the customer.
-- Gender: Stores the gender of the customer.
-- Customer_Status: Stores the current status of the customer.
-- Registration_Date: Stores the customer registration date.
-- Branch_ID: Stores the ID of the branch associated with the customer.

CREATE TABLE Customers (
    Customer_ID VARCHAR(10) PRIMARY KEY ,          -- PRIMARY KEY: Uniquely identifies each customer. 
    Customer_Name VARCHAR(100) NOT NULL,   -- NOT NULL: Customer name cannot be empty.
    Email VARCHAR(100) UNIQUE,             -- UNIQUE: Duplicate email addresses are not allowed.
    Phone VARCHAR(15) UNIQUE,               -- UNIQUE: Duplicate phone numbers are not allowed.
    City VARCHAR(50),
    Age INT,
    Gender CHAR(1),
    Customer_Status CHAR(1) DEFAULT 'A',     -- DEFAULT: Automatically assigns 'A' if no status is provided.
    Registration_Date DATE,
    Branch_ID INT NOT NULL,

    FOREIGN KEY (Branch_ID)           -- FOREIGN KEY: Connects the customer to a valid branch.
    REFERENCES Branches(Branch_ID)     -- REFERENCES: Refers to Branch_ID in the Branches table.
);

