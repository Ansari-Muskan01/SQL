# 5. Create Transactions Table

-- Transaction_ID: Unique ID for each transaction.
-- Account_ID: Stores the ID of the account associated with the transaction.
-- Transaction_Type: Stores the type of transaction, such as Deposit, Withdrawal, Transfer, or Payment.
-- Amount: Stores the amount involved in the transaction.
-- Transaction_Date: Stores the date when the transaction occurred.
-- Description: Stores additional details about the transaction.

CREATE TABLE Transactions (
    Transaction_ID INT PRIMARY KEY AUTO_INCREMENT,  -- PRIMARY KEY: Uniquely identifies each transaction.
    Account_ID INT NOT NULL,                        -- NOT NULL: Every transaction must be linked to an account.
    Transaction_Type VARCHAR(30) NOT NULL,          -- NOT NULL: Transaction type cannot be empty.
    Amount DECIMAL(12,2) NOT NULL,                  -- NOT NULL: Transaction amount is required.
    Transaction_Date DATE,                          -- Stores the date of the transaction.
    Description VARCHAR(200),                       -- Stores additional information about the transaction.

    FOREIGN KEY (Account_ID)                        -- FOREIGN KEY: Connects the transaction to a valid account.
    REFERENCES Accounts(Account_ID)                -- REFERENCES: Refers to Account_ID in the Accounts table.
);
