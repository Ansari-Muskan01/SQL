# 4. Create Accounts Table

-- Account_ID: Unique ID for each account.
-- Customer_ID: Stores the ID of the customer who owns the account.
-- Branch_ID: Stores the ID of the branch where the account is maintained.
-- Account_Type: Stores the type of account, such as Savings, Current, Salary, or Fixed Deposit.
-- Balance: Stores the current balance available in the account.
-- Account_Status: Stores the current status of the account, such as Active or Inactive.
-- Opening_Date: Stores the date when the account was opened.

CREATE TABLE Accounts (
    Account_ID INT PRIMARY KEY AUTO_INCREMENT,    -- PRIMARY KEY: Uniquely identifies each account.
    Customer_ID VARCHAR(10) NOT NULL,              -- NOT NULL: Every account must be linked to a customer.
    Branch_ID INT NOT NULL,                        -- NOT NULL: Every account must be linked to a branch.
    Account_Type VARCHAR(30) NOT NULL,             -- NOT NULL: Account type cannot be empty.
    Balance DECIMAL(12,2) DEFAULT 0,               -- DEFAULT: Automatically assigns 0 if no balance is provided.
    Account_Status VARCHAR(20) DEFAULT 'Active',   -- DEFAULT: Automatically assigns 'Active' if no status is provided.
    Opening_Date DATE,                             -- Stores the date on which the account was opened.

    FOREIGN KEY (Customer_ID)                      -- FOREIGN KEY: Connects the account to a valid customer.
    REFERENCES Customers(Customer_ID),             -- REFERENCES: Refers to Customer_ID in the Customers table.

    FOREIGN KEY (Branch_ID)                       -- FOREIGN KEY: Connects the account to a valid branch.
    REFERENCES Branches(Branch_ID)                 -- REFERENCES: Refers to Branch_ID in the Branches table.
);
