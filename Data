# 1. Create Database
CREATE DATABASE SmartBankDB;
USE SmartBankDB;

# 2. Create Branches Table

-- Branch_ID: Unique ID for each branch.
-- Branch_Name: Stores the name of the branch.   
-- City: Stores the city where the branch is located.
-- State: Stores the state where the branch is located.
-- Branch_Manager: Stores the name of the branch manager.
-- Contact_Number: Stores the branch contact number.
-- IFSC_Code: Stores the unique IFSC code of the branch.
-- Opening_Date: Stores the date when the branch was opened.

CREATE TABLE Branches (
    Branch_ID INT PRIMARY KEY AUTO_INCREMENT,         -- PRIMARY KEY: Uniquely identifies each branch. -- AUTO_INCREMENT: Automatically generates the ID.
    Branch_Name VARCHAR(100) NOT NULL,                -- NOT NULL: Branch name cannot be empty.
    City VARCHAR(50) NOT NULL,                        -- NOT NULL: City cannot be empty.
    State VARCHAR(50) NOT NULL,                       -- NOT NULL: State cannot be empty.
    Branch_Manager VARCHAR(100),
    Contact_Number VARCHAR(15),
    IFSC_Code VARCHAR(20) UNIQUE NOT NULL,            -- NOT NULL: IFSC code cannot be empty. -- UNIQUE: Duplicate IFSC_Code values are not allowed.
    Opening_Date DATE
);

