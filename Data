# 6. Create Loans Table

-- Loan_ID: Unique ID for each loan.
-- Customer_ID: Stores the ID of the customer who has taken the loan.
-- Branch_ID: Stores the ID of the branch associated with the loan.
-- Loan_Type: Stores the type of loan, such as Home Loan, Personal Loan, or Car Loan.
-- Loan_Amount: Stores the total amount of the loan.
-- Interest_Rate: Stores the interest rate applicable to the loan.
-- Loan_Term_Years: Stores the loan repayment period in years.
-- Loan_Status: Stores the current status of the loan, such as Active, Closed, or Pending.
-- Start_Date: Stores the date when the loan started.

CREATE TABLE Loans (
    Loan_ID INT PRIMARY KEY AUTO_INCREMENT,        -- PRIMARY KEY: Uniquely identifies each loan.
    Customer_ID VARCHAR(10) NOT NULL,               -- NOT NULL: Every loan must be linked to a customer.
    Branch_ID INT NOT NULL,                         -- NOT NULL: Every loan must be linked to a branch.
    Loan_Type VARCHAR(50) NOT NULL,                 -- NOT NULL: Loan type cannot be empty.
    Loan_Amount DECIMAL(15,2) NOT NULL,             -- NOT NULL: Loan amount is required.
    Interest_Rate DECIMAL(5,2),                     -- Stores the interest rate of the loan.
    Loan_Term_Years INT,                            -- Stores the loan repayment period in years.
    Loan_Status VARCHAR(30),                        -- Stores the current status of the loan.
    Start_Date DATE,                                -- Stores the loan start date.

    FOREIGN KEY (Customer_ID)                       -- FOREIGN KEY: Connects the loan to a valid customer.
    REFERENCES Customers(Customer_ID),              -- REFERENCES: Refers to Customer_ID in the Customers table.

    FOREIGN KEY (Branch_ID)                         -- FOREIGN KEY: Connects the loan to a valid branch.
    REFERENCES Branches(Branch_ID)                  -- REFERENCES: Refers to Branch_ID in the Branches table.
);

