-- 1. CREATE DATABASE
CREATE DATABASE database_name;

-- 2. USE DATABASE
USE database_name;

-- 3. SHOW DATABASES
SHOW DATABASES;

-- 4. DROP DATABASE
DROP DATABASE database_name;

-- 5. CREATE TABLE
CREATE TABLE table_name (column1 datatype, column2 datatype, column3 datatype);

-- 6. SHOW TABLES
SHOW TABLES;

-- 7. DESCRIBE TABLE
DESC table_name;

-- 8. INSERT
INSERT INTO table_name (column1, column2, column3) VALUES (value1, value2, value3);

-- 9. SELECT
SELECT column1, column2 FROM table_name;

-- 10. SELECT ALL
SELECT * FROM table_name;

-- 11. DISTINCT
SELECT DISTINCT column_name FROM table_name;

-- 12. WHERE
SELECT * FROM table_name WHERE condition;

-- 13. AND
SELECT * FROM table_name WHERE condition1 AND condition2;

-- 14. OR
SELECT * FROM table_name WHERE condition1 OR condition2;

-- 15. NOT
SELECT * FROM table_name WHERE NOT condition;

-- 16. BETWEEN
SELECT * FROM table_name WHERE column_name BETWEEN value1 AND value2;

-- 17. IN
SELECT * FROM table_name WHERE column_name IN (value1, value2, value3);

-- 18. NOT IN
SELECT * FROM table_name WHERE column_name NOT IN (value1, value2, value3);

-- 19. LIKE
SELECT * FROM table_name WHERE column_name LIKE 'pattern';

-- 20. IS NULL
SELECT * FROM table_name WHERE column_name IS NULL;

-- 21. IS NOT NULL
SELECT * FROM table_name WHERE column_name IS NOT NULL;

-- 22. ORDER BY ASC
SELECT * FROM table_name ORDER BY column_name ASC;

-- 23. ORDER BY DESC
SELECT * FROM table_name ORDER BY column_name DESC;

-- 24. LIMIT
SELECT * FROM table_name LIMIT number;

-- 25. UPDATE
UPDATE table_name SET column_name = value WHERE condition;

-- 26. DELETE
DELETE FROM table_name WHERE condition;

-- 27. ALTER ADD
ALTER TABLE table_name ADD column_name datatype;

-- 28. ALTER MODIFY
ALTER TABLE table_name MODIFY column_name datatype;

-- 29. ALTER RENAME
ALTER TABLE table_name RENAME COLUMN old_column_name TO new_column_name;

-- 30. ALTER DROP
ALTER TABLE table_name DROP COLUMN column_name;

-- 31. RENAME TABLE
RENAME TABLE old_table_name TO new_table_name;

-- 32. DROP TABLE
DROP TABLE table_name;

-- 33. TRUNCATE TABLE
TRUNCATE TABLE table_name;

-- 34. PRIMARY KEY
CREATE TABLE table_name (column_name datatype PRIMARY KEY);

-- 35. NOT NULL
CREATE TABLE table_name (column_name datatype NOT NULL);

-- 36. UNIQUE
CREATE TABLE table_name (column_name datatype UNIQUE);

-- 37. DEFAULT
CREATE TABLE table_name (column_name datatype DEFAULT value);

-- 38. CHECK
CREATE TABLE table_name (column_name datatype CHECK (condition));

-- 39. AUTO_INCREMENT
CREATE TABLE table_name (column_name datatype PRIMARY KEY AUTO_INCREMENT);

-- 40. FOREIGN KEY
CREATE TABLE table_name (column_name datatype, FOREIGN KEY (column_name) REFERENCES parent_table(parent_column));

-- 41. COUNT
SELECT COUNT(column_name) FROM table_name;

-- 42. SUM
SELECT SUM(column_name) FROM table_name;

-- 43. AVG
SELECT AVG(column_name) FROM table_name;

-- 44. MIN
SELECT MIN(column_name) FROM table_name;

-- 45. MAX
SELECT MAX(column_name) FROM table_name;

-- 46. GROUP BY
SELECT column_name, aggregate_function(column_name) FROM table_name GROUP BY column_name;

-- 47. HAVING
SELECT column_name, aggregate_function(column_name) FROM table_name GROUP BY column_name HAVING condition;

-- 48. INNER JOIN
SELECT columns FROM table1 INNER JOIN table2 ON table1.column_name = table2.column_name;

-- 49. LEFT JOIN
SELECT columns FROM table1 LEFT JOIN table2 ON table1.column_name = table2.column_name;

-- 50. RIGHT JOIN
SELECT columns FROM table1 RIGHT JOIN table2 ON table1.column_name = table2.column_name;

-- 51. CROSS JOIN
SELECT columns FROM table1 CROSS JOIN table2;

-- 52. SELF JOIN
SELECT a.column_name, b.column_name FROM table_name a JOIN table_name b ON a.column_name = b.column_name;

-- 53. SUBQUERY
SELECT * FROM table_name WHERE column_name operator (SELECT column_name FROM table_name);

-- 54. EXISTS
SELECT * FROM table1 WHERE EXISTS (SELECT 1 FROM table2 WHERE condition);

-- 55. UNION
SELECT columns FROM table1 UNION SELECT columns FROM table2;

-- 56. UNION ALL
SELECT columns FROM table1 UNION ALL SELECT columns FROM table2;

-- 57. CASE
SELECT column_name, CASE WHEN condition THEN result ELSE result END AS alias_name FROM table_name;

-- 58. CREATE VIEW
CREATE VIEW view_name AS SELECT columns FROM table_name WHERE condition;

-- 59. DROP VIEW
DROP VIEW view_name;

-- 60. CREATE INDEX
CREATE INDEX index_name ON table_name (column_name);

-- 61. DROP INDEX
DROP INDEX index_name ON table_name;

-- 62. ROW_NUMBER
SELECT columns, ROW_NUMBER() OVER (ORDER BY column_name) AS alias_name FROM table_name;

-- 63. RANK
SELECT columns, RANK() OVER (ORDER BY column_name DESC) AS alias_name FROM table_name;

-- 64. DENSE_RANK
SELECT columns, DENSE_RANK() OVER (ORDER BY column_name DESC) AS alias_name FROM table_name;

-- 65. PARTITION BY
SELECT columns, aggregate_function(column_name) OVER (PARTITION BY column_name) AS alias_name FROM table_name;

-- 66. COMMIT
COMMIT;

-- 67. ROLLBACK
ROLLBACK;

-- 68. SAVEPOINT
SAVEPOINT savepoint_name;

-- 69. ROLLBACK TO SAVEPOINT
ROLLBACK TO SAVEPOINT savepoint_name;

-- 70. CREATE USER
CREATE USER 'username'@'localhost' IDENTIFIED BY 'password';

-- 71. GRANT
GRANT privilege ON database_name.table_name TO 'username'@'localhost';

-- 72. REVOKE
REVOKE privilege ON database_name.table_name FROM 'username'@'localhost';

-- 73. SHOW GRANTS
SHOW GRANTS FOR 'username'@'localhost';
