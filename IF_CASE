-- IF and CASE in SQL
-- IF() is a conditional function in SQL that evaluates a condition and returns one value if the condition is TRUE 
-- and another value if the condition is FALSE.

-- Syntax : IF(condition, value_if_true, value_if_false)

select * from Orders ; 

-- Q: Display the Order_ID, Order_Amount, and show 'High Value'
-- if the order amount is 500 or more; otherwise show 'Regular'.

SELECT Order_ID, Order_Amount,
    IF(Order_Amount >= 500, 'High Value', 'Regular') AS Order_Category FROM Orders;


-- Q: Display the Order_ID, Payment_Mode, and show 'Online Payment'
-- if the payment mode is UPI or Card; otherwise show 'Cash Payment'.

SELECT  Order_ID, Payment_Mode,
    IF(Payment_Mode IN ('UPI', 'Card'), 'Online Payment', 'Cash Payment') AS Payment_Type FROM Orders;
    
-- Q: Display the Order_ID, Order_Status and show:
-- 'Completed' if the order status is Delivered
-- 'In Progress' if the order status is Pending
-- 'Not Completed' if the order status is Cancelled.

SELECT Order_ID, Order_Status,
    IF(Order_Status = 'Delivered', 'Completed', 
        IF(Order_Status = 'Pending', 'In Progress', 'Not Completed')) AS Delivery_Status FROM Orders;
    
-- Update the Delivery_Status column using Nested IF
ALTER TABLE Orders ADD COLUMN Delivery_Status VARCHAR (20); 
SELECT * FROM Orders ; 

UPDATE Orders SET Delivery_Status = IF(Order_Status = 'Delivered', 'Completed',
       IF(Order_Status = 'Pending', 'In Progress', 'Not Completed')
    );
    
SELECT * FROM Orders ;   

-- CASE is used to check multiple conditions and return a different result for each condition.
-- Syntax : 
-- CASE
--     WHEN condition1 THEN result1
--     WHEN condition2 THEN result2
--     ELSE result
-- END

-- Categorize orders based on order amount.
-- Display the Order_ID and categorize orders as:
-- High → 800 or more
-- Medium → 500 to 799
-- Low → below 500

SELECT * FROM Orders ; 

SELECT Order_ID, Order_Amount,
    CASE
        WHEN Order_Amount >= 800 THEN 'High'
        WHEN Order_Amount >= 500 THEN 'Medium'
        ELSE 'Low'
    END AS Order_Category
FROM Orders;


