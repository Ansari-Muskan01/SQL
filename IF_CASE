-- Scenario: A food delivery company wants to maintain information about its customers and the food orders they place. 
-- The database stores customer details such as name, city, gender, age, and membership. It also stores order details such as restaurant, 
-- food category, order amount, delivery fee, payment mode, order status, and delivery time.

-- For this scenario, we will create two related tables:
-- Customers → Stores information about customers.
-- Orders → Stores food orders placed by customers.

-- The Customer_ID in the Orders table is a Foreign Key that connects each order to the corresponding customer in the Customers table.(Hint)

-- USE Database
USE Sample ; 

-- 1. Customers Table

CREATE TABLE Customers (
Customer_ID INT PRIMARY KEY,
Name VARCHAR(50),
City VARCHAR(20) NOT NULL,
Gender CHAR(1) CHECK (Gender IN ('M', 'F')),
Age INT CHECK (Age >= 18),
Membership VARCHAR(20),
Email VARCHAR(100) UNIQUE
);

-- 2. Orders Table
CREATE TABLE Orders (
Order_ID INT PRIMARY KEY,
Customer_ID INT NOT NULL ,
Restaurant_Name VARCHAR(50) NOT nULL,
Food_Category VARCHAR(30) NOT NULL,
Order_Amount DECIMAL(10,2) CHECK (Order_Amount > 0),
Delivery_Fee DECIMAL(10,2) DEFAULT 0,
Payment_Mode VARCHAR(20) DEFAULT "Cash",
Order_Status VARCHAR(20) NOT NULL ,
Order_Date DATE NOT NULL,
Delivery_Time_Min INT NOT NULL,
FOREIGN KEY (Customer_ID) REFERENCES Customers(Customer_ID)     -- Connects the Orders table with the Customers table
);

