-- A subquery  is a query written INSIDE another query.

-- The subquery is always enclosed in parentheses ( ).
-- The subquery runs first, and its result is then used by the outer query as a value, a list of values, or a condition.

-- Basic syntax:

-- OUTER QUERY
-- 
-- SELECT column_name(s) FROM table_name WHERE column_name OPERATOR (SELECT column_name FROM table_name WHERE condition); -- INNER QUERY / SUBQUERY

-- Types of subqueries (based on what the inner query returns):
-- 1) Single-row subquery   -> returns exactly ONE value   -> use =, >, <, >=, <=
-- 2) Multi-row subquery    -> returns MULTIPLE values     -> use IN, ANY, ALL
-- 3) Correlated subquery   -> depends on the outer query's current row
-- 4) Nested subquery       -> 



CREATE TABLE Employees (
    emp_id      INT PRIMARY KEY,
    emp_name    VARCHAR(50),
    department  VARCHAR(20),
    salary      INT
);

INSERT INTO Employees VALUES
(1, 'Aditi',  'IT',    75000),
(2, 'Rahul',  'IT',    55000),
(3, 'Sneha',  'HR',    48000),
(4, 'Karan',  'HR',    55000),
(5, 'Meena',  'HR',    60000),
(6, 'Vikas',  'Sales', 50000),
(7, 'Priya',  'Sales', 75000),
(8, 'Farhan', 'Sales', 45000),
(9, 'Divya',  'IT',    60000),
(10,'Aman',   'IT',    58000),
(11,'Rohan',   'Sales',30000),
(12,'Ayyan',   'HR',    20000);

select * from Employees ; 

SELECT MAX(salary) FROM Employees ; -- returns exactly ONE value
SELECT * FROM Employees WHERE salary >= 75000 ; 

-- 1) Single-row subquery   -> returns exactly ONE value   -> use =, >, <, >=, <=

-- Q1 : Find the name and salary of the highest-paid employee
SELECT emp_name, department, salary FROM Employees
    WHERE salary = (SELECT MAX(salary) FROM Employees);

-- Execution order:
-- 1) Inner query runs first  -> SELECT MAX(salary) FROM Employees -> returns 75000
-- 2) Outer query becomes     -> WHERE salary = 75000
-- Output: Aditi (IT, 75000), Priya (Sales, 75000)

-- 2) Multi-row subquery    -> returns MULTIPLE values     -> use IN, ANY, ALL

-- Q2 : Show the employees whose salary matches any salary paid to an IT department employee
SELECT * FROM Employees WHERE department = 'IT' ;   -- Aditi(75000), Rahul(55000), Divya(60000), Aman(58000)

-- So the inner query returns this list of salaries: -- salary IN (75000, 55000, 60000, 58000)

SELECT emp_name, department, salary FROM Employees
WHERE salary IN (SELECT salary FROM Employees WHERE department = 'IT');

-- Execution order:
-- 1) Inner query runs first -> gets IT salaries -> (75000, 55000, 60000, 58000)
-- 2) Outer query becomes    -> WHERE salary IN (75000, 55000, 60000, 58000)


-- Output (7 rows):
-- Aditi  | IT    | 75000   <- IT employee
-- Rahul  | IT    | 55000   <- IT employee
-- Karan  | HR    | 55000   <- HR, but salary matches Rahul's (IT)
-- Meena  | HR    | 60000   <- HR, but salary matches Divya's (IT)
-- Priya  | Sales | 75000   <- Sales, but salary matches Aditi's (IT)
-- Divya  | IT    | 60000   <- IT employee
-- Aman   | IT    | 58000   <- IT employee

-- Rohan (30000) and Ayyan (20000) do NOT appear,
-- because their salaries don't match any IT employee's salary.


-- Q3 : Find employees earning more than the average salary of their OWN department

-- First, let's see the average salary of each department:
SELECT department, AVG(salary) AS dept_avg FROM Employees GROUP BY department;

-- department	dept_avg
-- IT			62000
-- HR	        45750
-- Sales		50000

-- e1 = outer table's current row
-- e2 = inner query's own copy of the table
-- The inner query filters e2 rows based on the department of the current e1 row and calculates the department average

SELECT e1.emp_name, e1.department, e1.salary
FROM Employees e1
WHERE e1.salary > (
    SELECT AVG(e2.salary) FROM Employees e2
    WHERE e2.department = e1.department ); -- << CORRELATION happens here
                                                 

-- Output:
-- emp_name | department | salary | dept_avg | condition (salary > dept_avg) | result
-- Aditi    | IT         | 75000  | 62000    | 75000 > 62000  -> TRUE        | ✅ Included
-- Rahul    | IT         | 55000  | 62000    | 55000 > 62000  -> FALSE       | ❌ Excluded
-- Divya    | IT         | 60000  | 62000    | 60000 > 62000  -> FALSE       | ❌ Excluded
-- Aman     | IT         | 58000  | 62000    | 58000 > 62000  -> FALSE       | ❌ Excluded
-- Sneha    | HR         | 48000  | 45750    | 48000 > 45750  -> TRUE        | ✅ Included
-- Karan    | HR         | 55000  | 45750    | 55000 > 45750  -> TRUE        | ✅ Included
-- Meena    | HR         | 60000  | 45750    | 60000 > 45750  -> TRUE        | ✅ Included
-- Ayyan    | HR         | 20000  | 45750    | 20000 > 45750  -> FALSE       | ❌ Excluded
-- Vikas    | Sales      | 50000  | 50000    | 50000 > 50000  -> FALSE (equal, not >) | ❌ Excluded
-- Priya    | Sales      | 75000  | 50000    | 75000 > 50000  -> TRUE        | ✅ Included
-- Farhan   | Sales      | 45000  | 50000    | 45000 > 50000  -> FALSE       | ❌ Excluded
-- Rohan    | Sales      | 30000  | 50000    | 30000 > 50000  -> FALSE       | ❌ Excluded

-- In a correlated subquery, the outer query provides a value to the inner query for each row.


-- Q4 :  Find employee(s) with the SECOND-HIGHEST salary

SELECT emp_name, department, salary  -- OUTER QUERY (runs LAST)
FROM Employees

WHERE salary = ( SELECT MAX(salary) FROM Employees  
    WHERE salary < (SELECT MAX(salary) FROM Employees)
);

-- Step 1: The innermost query finds the highest salary -> 75000
-- Step 2: The middle query finds the highest salary below 75000 -> 60000
-- Step 3: The outer query finds employees whose salary is 60000



-- Execution rule:
-- Normal subquery     -> Inner query runs first, then Outer query.
-- Correlated subquery -> Outer query takes one row, then the Inner query
--                        uses that row's value. This repeats for each row.
