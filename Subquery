-- Types of Subqueries
-- Single-Row Subquery → Returns one row/value
-- Multiple-Row Subquery → Returns multiple rows
-- Nested Subquery → Subquery inside another subquery
-- Correlated Subquery → Inner query depends on the outer query


-- Single-Row Subquery → Returns one row/value
SELECT AVG(SALARY) FROM Employees ;  # 55000
SELECT * FROM Employees WHERE SALARY > 55000 ; 

-- Question: Find employees whose salary is greater than the average salary. (Single-Row Subquery)
SELECT Employee_Name, Salary FROM Employees
WHERE Salary > ( SELECT AVG(Salary) FROM Employees );


-- Find employees who earn the highest salary in the company.
SELECT Employee_Name, Salary FROM Employees
WHERE Salary = ( SELECT MAX(Salary) FROM Employees );



-- Multiple-Row Subquery → Returns multiple rows
-- Question: Find employees who work in the same departments as employees whose salary is greater than 60,000. (Multiple-Row Subquery)
SELECT * FROM Employees WHERE Salary > 60000 ; 


SELECT Employee_Name, Department FROM Employees
WHERE Department IN (SELECT Department FROM Employees WHERE Salary > 60000);

-- Nested Subquery → Subquery inside another subquery
-- Find all employees working in the department of the company's highest-paid employee.

SELECT Employee_Name, Department, Salary
FROM Employees
WHERE Department = ( SELECT Department FROM Employees     #Find the department of the highest-paid employee
    WHERE Salary = (SELECT MAX(Salary) FROM Employees)    #Find the highest salary in the company
);

-- Correlated Subquery → Inner query depends on the outer query
-- Find employees whose salary is greater than the average salary of their own department.

SELECT Employee_Name, Department, Salary FROM Employees AS e
WHERE Salary = (SELECT MAX(Salary) FROM Employees  # Find the highest salary for the current employee's department
    WHERE Department = e.Department                # e.Department comes from the outer query
);

-- e → Alias for the outer Employees table
-- e.Department → Gets the department of the current employee
-- MAX(Salary) → Finds the highest salary in that department
-- WHERE Salary = → Compares the employee's salary with that department's maximum salary



-- EXECUTION ORDER OF SUBQUERIES

-- 1. Normal Subquery
-- The INNER QUERY runs first.
-- It returns a result.
-- The OUTER QUERY then uses that result.


-- 2. Multiple-Row Subquery
-- The INNER QUERY runs first and returns multiple values.
-- The OUTER QUERY then uses those values.

-- 3. Nested Subquery
-- When one subquery is written inside another subquery,
-- the INNERMOST query is evaluated first.


-- 4. Correlated Subquery
-- The inner query depends on the current row
-- of the outer query.
-- Therefore, the inner query is evaluated for each row
-- of the outer query.
