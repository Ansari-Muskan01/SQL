-- SUBQUERY IN SQL

-- Definition : Subquery is a query written inside another SQL query. It is also called a Nested Query or Inner Query.
-- In a subquery, the inner query provides a result that is used by the outer query.


-- Basic Syntax
-- OUTER QUERY
-- SELECT column_name
-- FROM table_name
-- WHERE column_name operator
-- (
--     INNER QUERY / SUBQUERY
--     SELECT column_name
--     FROM table_name
--     WHERE condition
-- );

-- The subquery is enclosed within parentheses ( ).

-- CREATE TABLE
CREATE TABLE Employees (
    Employee_ID INT PRIMARY KEY,
    Employee_Name VARCHAR(50),
    Department VARCHAR(50),
    Salary DECIMAL(10,2)
);

