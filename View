-- VIEW

-- Definition : A VIEW is a virtual table created from a SQL query. It allows us to view specific data from one or more tables without storing a separate copy of the data.

-- Syntax :  CREATE VIEW view_name AS SELECT column1, column2 FROM table_name WHERE condition;

CREATE TABLE Customers (
    Customer_ID INT PRIMARY KEY,
    Customer_Name VARCHAR(50),
    City VARCHAR(50),
    Age INT,
    Customer_Status VARCHAR(20)
);


