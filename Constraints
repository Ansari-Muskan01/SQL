-- Question4: Create a Customers table where Age must be greater than or equal to 18. (HINT : CHECK) 
CREATE TABLE Customers (
    Customer_ID INT,
    Customer_Name VARCHAR(100),
    Age INT CHECK (Age >= 18)
);
-- Insert one record
INSERT INTO Customers VALUES (1, 'Aarav Sharma', 28);
DESCRIBE Customers ; 
DROP TABLE Customers ; 


-- Question5: Create an Accounts table where Account_Status should have a DEFAULT value of 'Active' when no status is provided. (HINT : DEFAULT)
CREATE TABLE Accounts (
    Account_ID INT,
    Account_Type VARCHAR(50),
    Account_Status VARCHAR(20) DEFAULT 'Active'
);

-- Insert one record without providing Account_Status
INSERT INTO Accounts (Account_ID, Account_Type) VALUES (101, 'Savings');
DESCRIBE Customers ; 
DROP TABLE Customers ; 


-- Question 6: Create a Customers table where Customer_ID should automatically generate a new numeric value whenever a new customer record is inserted. (AUTO_INCREMENT)
CREATE TABLE Customers (
    Customer_ID INT PRIMARY KEY AUTO_INCREMENT,
    Customer_Name VARCHAR(100),
    Email VARCHAR(100)
);
-- Insert one record without providing Customer_ID
INSERT INTO Customers (Customer_Name, Email) VALUES ('Aarav Sharma', 'aarav@gmail.com');
DESCRIBE Customers ; 
DROP TABLE Customers ; 


-- Question 7: Create two tables: Customers and Accounts.
-- Create a relationship between the two tables using Customer_ID.
-- Customer_ID in the Accounts table should refer to Customer_ID in the Customers table. (HINT: FOREIGN KEY)

CREATE TABLE Customers (
    Customer_ID INT PRIMARY KEY,
    Customer_Name VARCHAR(100)
);

-- Child Table

CREATE TABLE Accounts (
    Account_ID INT PRIMARY KEY,
    Customer_ID INT,
    Account_Type VARCHAR(50),
    FOREIGN KEY (Customer_ID) REFERENCES Customers(Customer_ID)
);

-- Insert one record into Customers first
INSERT INTO Customers VALUES (1, 'Aarav Sharma');

-- Insert one record into Accounts
INSERT INTO Accounts VALUES (101, 1, 'Savings');

DESCRIBE Customers ; 
DESCRIBE Accounts ; 

DROP TABLE Customers ; 
DROP TABLE  Accounts ; 

