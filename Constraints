-- Types of Constraints
-- Constraints are rules applied to columns in a table to control the type of data that can be stored and maintain data accuracy.

-- Constraint      | Purpose                                         |
-- --------------- | ----------------------------------------------- |
-- NOT NULL        | Prevents empty/NULL values                      |
-- UNIQUE          | Prevents duplicate values                       |
-- PRIMARY KEY     | Uniquely identifies each record                 |
-- CHECK           | Ensures values satisfy a condition              |
-- DEFAULT         | Provides a default value when no value is given |
-- AUTO_INCREMENT  | Automatically generates the next numeric value  |
-- FOREIGN KEY     | Creates a relationship between tables           |

-- SYNTAX : 
-- CREATE TABLE TABLE_NAME (
--     COLUMN_NAME DATA_TYPE CONSTRAINT,
--     COLUMN_NAME DATA_TYPE CONSTRAINT,
--     COLUMN_NAME DATA_TYPE CONSTRAINT
-- );

-- Create a Customers table with the following columns:
-- Customer_ID
-- Customer_Name
-- Gender
-- Email
-- Phone
-- Age
-- Account_Balance
-- Registration_Date
-- Customer_Status

-- USE DATABASE : 
USE SAMPLE ; 

-- SAMPLE TABLE WITHOUT CONSTRAINTS:
CREATE TABLE Customers (
    Customer_ID INT,
    Customer_Name VARCHAR(100),
    Gender CHAR(1),
    Email VARCHAR(100),
    Phone VARCHAR(15),
    Age INT,
    Account_Balance DECIMAL(12,2),
    Registration_Date DATE,
    Customer_Status VARCHAR(20)
);

-- INSERT DATA
-- Method 1: INSERT data without specifying column names.
-- HINT: Values must be provided in the same order as the table columns.
INSERT INTO Customers VALUES (1, 'Aarav Sharma', 'M', 'aarav@gmail.com', '9876543210', 28, 75000.50, '2026-01-15', 'Active') ; 


-- Method 2: INSERT data by specifying column names.
-- HINT: Specify the column names first, then provide the corresponding values.
INSERT INTO Customers  (Customer_ID, Customer_Name, Gender, Email, Phone, Age, Account_Balance, Registration_Date, Customer_Status)
VALUES (2, 'Priya Mehta', 'F', 'priya@gmail.com', '9123456789', 32, 125000.75, '2026-02-10', 'Active');


-- Example: INSERT NULL values
INSERT INTO Customers VALUES (3, NULL, 'M', 'rahul@gmail.com', '9988776655', NULL, 50000.00, '2026-03-05', 'Active');

-- Example: Duplicate values
INSERT INTO Customers VALUES (1, 'Aarav Sharma', 'M', 'aarav@gmail.com', '9876543210', 28, 75000.50, '2026-01-15', 'Active');

-- CHECK TABLE 
SELECT * FROM Customers ; 

-- DESCRIBE is used to view the structure of a table, including column names, data types, NULL values, keys, and default values.
DESCRIBE Customers ; 



-- Apply the following constraints:
-- Question1: Create a Customers table where Customer_Name and Phone cannot contain NULL values. (HINT : NOT NULL)

CREATE TABLE Customers (
    Customer_ID INT,
    Customer_Name VARCHAR(100) NOT NULL,
    Phone VARCHAR(15) NOT NULL
);

-- Insert one record
INSERT INTO Customers VALUES (1, 'Aarav Sharma', '9876543210');
DESCRIBE Customers ; 
DROP TABLE Customers ; 



