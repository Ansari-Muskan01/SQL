-- Constraints : 
-- Constraints are rules applied to columns in a table to control the data that can be stored and maintain data accuracy and consistency.

-- TYPES OF CONSTRAINTS:

-- Constraint      | Purpose                                         |
-- --------------- | ----------------------------------------------- |
-- NOT NULL        | Prevents empty/NULL values                      |
-- UNIQUE          | Prevents duplicate values                       |
-- PRIMARY KEY     | Uniquely identifies each record                 |
-- CHECK           | Ensures values satisfy a condition              |
-- DEFAULT         | Provides a default value when no value is given |
-- AUTO_INCREMENT  | Automatically generates the next numeric value  |
-- FOREIGN KEY     | Creates a relationship between tables           |

-- SYNTAX : 
-- CREATE TABLE TABLE_NAME (
--     COLUMN_NAME DATA_TYPE CONSTRAINT,
--     COLUMN_NAME DATA_TYPE CONSTRAINT,
--     COLUMN_NAME DATA_TYPE CONSTRAINT
-- );

-- Create a Customers table with the following columns:
-- Customer_ID
-- Customer_Name
-- Gender
-- Email
-- Phone
-- Age
-- Account_Balance
-- Registration_Date
-- Customer_Status



-- 1. CUSTOMERS TABLE


-- Customer_ID      → PRIMARY KEY + AUTO_INCREMENT
-- Customer_Name    → NOT NULL
-- Email            → UNIQUE
-- Age              → CHECK
-- Customer_Status  → DEFAULT

CREATE TABLE Customers (
    Customer_ID INT PRIMARY KEY AUTO_INCREMENT,
    Customer_Name VARCHAR(100) NOT NULL,
    Email VARCHAR(100) UNIQUE,

    Age INT CHECK (Age >= 18),
    Customer_Status VARCHAR(20) DEFAULT 'Active'
);


-- 2. ACCOUNTS TABLE


-- Account_ID       → PRIMARY KEY + AUTO_INCREMENT
-- Customer_ID      → FOREIGN KEY
-- Account_Type     → NOT NULL
-- Account_Balance → DEFAULT

CREATE TABLE Accounts (
    Account_ID INT PRIMARY KEY AUTO_INCREMENT,
    Customer_ID INT,
    Account_Type VARCHAR(50) NOT NULL,
    Account_Balance DECIMAL(12,2) DEFAULT 0,
    
    FOREIGN KEY (Customer_ID)
        REFERENCES Customers(Customer_ID)
);


