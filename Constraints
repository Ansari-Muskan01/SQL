    Customer_ID INT PRIMARY KEY,
    Customer_Name VARCHAR(100),
    Email VARCHAR(100)
);
-- Insert one record 
INSERT INTO Customers VALUES (1, 'Aarav Sharma', 'aarav@gmail.com');
